{
  "info": {
    "_postman_id": "subsense-ai-phase3-api",
    "name": "SubSense AI - Phase 3 Database, Bills, Subscriptions & Dashboard APIs",
    "description": "Postman Collection for SubSense AI Phase 3 CRUD endpoints, filtering, searching, sorting, pagination, and MongoDB Aggregation Dashboard Analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "bearer_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "bill_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "subscription_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login User & Set Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@subsense.ai\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('bearer_token', jsonData.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Bills APIs",
      "item": [
        {
          "name": "Create Bill",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Electricity Monthly Bill\",\n  \"merchant\": \"Power Grid Ltd\",\n  \"category\": \"Utilities\",\n  \"amount\": 145.50,\n  \"dueDate\": \"2026-08-10T00:00:00.000Z\",\n  \"status\": \"Pending\",\n  \"paymentMethod\": \"Credit Card\",\n  \"notes\": \"Air conditioning summer usage\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/bills",
              "host": ["{{base_url}}"],
              "path": ["bills"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('bill_id', jsonData.data._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Bills (Filter, Search, Sort & Paginate)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bills?category=Utilities&search=Electricity&sort=due_date_asc&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["bills"],
              "query": [
                { "key": "category", "value": "Utilities" },
                { "key": "search", "value": "Electricity" },
                { "key": "sort", "value": "due_date_asc" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Bill By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bills/{{bill_id}}",
              "host": ["{{base_url}}"],
              "path": ["bills", "{{bill_id}}"]
            }
          }
        },
        {
          "name": "Update Bill",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Paid\",\n  \"amount\": 145.50\n}"
            },
            "url": {
              "raw": "{{base_url}}/bills/{{bill_id}}",
              "host": ["{{base_url}}"],
              "path": ["bills", "{{bill_id}}"]
            }
          }
        },
        {
          "name": "Delete Bill",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bills/{{bill_id}}",
              "host": ["{{base_url}}"],
              "path": ["bills", "{{bill_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Subscriptions APIs",
      "item": [
        {
          "name": "Create Subscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Spotify Family Plan\",\n  \"provider\": \"Spotify\",\n  \"price\": 16.99,\n  \"billingCycle\": \"Monthly\",\n  \"renewalDate\": \"2026-08-01T00:00:00.000Z\",\n  \"category\": \"Music & Entertainment\",\n  \"status\": \"Active\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/subscriptions",
              "host": ["{{base_url}}"],
              "path": ["subscriptions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('subscription_id', jsonData.data._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Subscriptions (Filter & Paginate)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/subscriptions?status=Active&sort=price_desc&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["subscriptions"],
              "query": [
                { "key": "status", "value": "Active" },
                { "key": "sort", "value": "price_desc" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Subscription By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/subscriptions/{{subscription_id}}",
              "host": ["{{base_url}}"],
              "path": ["subscriptions", "{{subscription_id}}"]
            }
          }
        },
        {
          "name": "Update Subscription",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Paused\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/subscriptions/{{subscription_id}}",
              "host": ["{{base_url}}"],
              "path": ["subscriptions", "{{subscription_id}}"]
            }
          }
        },
        {
          "name": "Delete Subscription",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/subscriptions/{{subscription_id}}",
              "host": ["{{base_url}}"],
              "path": ["subscriptions", "{{subscription_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Dashboard APIs",
      "item": [
        {
          "name": "GET Dashboard Overview",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard",
              "host": ["{{base_url}}"],
              "path": ["dashboard"]
            }
          }
        },
        {
          "name": "GET Dashboard Financial Summary (Aggregations)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dashboard/summary",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "summary"]
            }
          }
        }
      ]
    }
  ]
}
