{
  "info": {
    "name": "SubSense AI - Complete Backend API Collection",
    "description": "Comprehensive Postman Collection covering Authentication, User Profile, Bills Management, OCR Upload, Subscriptions, Dashboard Analytics, Health Score, Expense Forecasting, AI Assistant, Notifications, and Gmail Sync.",
