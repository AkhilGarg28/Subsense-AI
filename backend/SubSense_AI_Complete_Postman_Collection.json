    {
      "name": "Bills",
      "item": [
        {
          "name": "Create Bill",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Electricity Bill\",\n  \"merchant\": \"Power Grid Ltd\",\n  \"category\": \"Utilities\",\n  \"amount\": 145.50,\n  \"dueDate\": \"2026-08-15T00:00:00.000Z\",\n  \"status\": \"Pending\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bills",
              "host": ["{{baseUrl}}"],
              "path": ["bills"]
            }
          }
        },
        {
          "name": "Upload Bill (OCR)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "receipt",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/bills/upload",
              "host": ["{{baseUrl}}"],
              "path": ["bills", "upload"]
            }
          }
        },
        {
          "name": "Get Bills List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bills?category=Utilities&status=Pending&sort=newest&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["bills"],
              "query": [
                { "key": "category", "value": "Utilities" },
                { "key": "status", "value": "Pending" },
                { "key": "sort", "value": "newest" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Bill By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bills/:id",
              "host": ["{{baseUrl}}"],
              "path": ["bills", ":id"]
            }
          }
        },
        {
          "name": "Update Bill",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Paid\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bills/:id",
              "host": ["{{baseUrl}}"],
              "path": ["bills", ":id"]
            }
          }
        },
        {
          "name": "Delete Bill",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bills/:id",
              "host": ["{{baseUrl}}"],
              "path": ["bills", ":id"]
            }
          }
        }
